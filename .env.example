PASSWORD=use-a-long-random-password
GOOGLE_CREDENTIALS={"client_email":"service-account@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# Optional. The existing dashboard sheet is used when omitted.
GOOGLE_SHEET_ID=
FASTMAIL_API_TOKEN=replace-with-a-fastmail-api-token
# Use a different random value of at least 32 characters.
CRON_SECRET=replace-with-a-long-random-secret
# How far back each sync searches (1-90 days).
FASTMAIL_IMPORT_DAYS=14
